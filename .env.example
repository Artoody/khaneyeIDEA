# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/khaneyeidea
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=change-me-to-64-random-hex-chars
DEFAULT_TENANT_SLUG=khaneyeide

# OTP delivery: console (dev) | bale | kavenegar
OTP_PROVIDER=console

# AI (see docs/specs/AI-PROVIDER.md): gemini-compatible | openai-compatible | none
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
