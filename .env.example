# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/khaneyeidea
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=change-me-to-64-random-hex-chars
DEFAULT_TENANT_SLUG=khaneyeide

# Public address of the site (used in bot links). Bots refuse localhost links in buttons.
SITE_URL=http://localhost:3000

# Bots: tokens only here, never in code or chat. Check with: pnpm bot:check   Run with: pnpm bot:dev
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# Telegram is blocked from Iran: use a local proxy (http://, https:// or socks5://, e.g. socks5://127.0.0.1:10808)
# or a relay server outside Iran as the API root.
TELEGRAM_PROXY_URL=
TELEGRAM_API_ROOT=

# OTP delivery: console (dev) | bale | kavenegar
OTP_PROVIDER=console

# AI (see docs/specs/AI-PROVIDER.md): gemini-compatible | openai-compatible | none
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
