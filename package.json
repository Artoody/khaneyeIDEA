{
  "name": "khaneyeidea",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @khaneyeidea/db generate",
    "db:migrate": "pnpm --filter @khaneyeidea/db migrate",
    "db:seed": "pnpm --filter @khaneyeidea/db seed"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
